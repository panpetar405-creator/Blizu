[{"type":"node","id":9798772472,"tags":{"name":"Gradina na Bosutu","name:sr":"Градина на Босуту","name:sr-Latn":"Gradina na Bosutu","name:en":"Gradina na Bosutu","historic":"archaeological_site","description":"Локалитет Градина налази се у атару села Вашице код Шида, на левој обали Босута. Својим положајем и висином доминира околним тереном. Резултати досадашњих истраживања показали су да се ради о вишеслојном праисторијском насељу следеће хронолошко-стратиграф","wikidata":"Q5591931","website":"https://nasledje.gov.rs/index.cfm/spomenici/pregled_spomenika?spomenik_id=108949"},"lat":45.074167,"lon":19.146677},{"type":"way","id":692362999,"tags":{"name":"Spomen-obeležje Sremski front","name:sr":"Спомен-обележје Сремски фронт","name:sr-Latn":"Spomen-obeležje Sremski front","name:en":"Syrmian Front Memorial Complex","historic":"monument"},"center":{"lat":45.049568,"lon":19.177955}},{"type":"way","id":954653074,"tags":{"name":"Košuta","name:sr":"Кошута","name:sr-Latn":"Košuta","amenity":"restaurant"},"center":{"lat":45.021817,"lon":19.137203}}]